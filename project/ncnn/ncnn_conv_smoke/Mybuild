package embox.cmd.ncnn

@App
@AutoCmd
@CxxCmd(name="ncnn_conv_smoke", help="Verify NCNN convolution, ReLU and pooling in external SDRAM")
@Build(stage=2)
@BuildDepends(third_party.lib.ncnn.libncnn)
@BuildDepends(third_party.lib.ncnn.ncnn_public_headers)
@BuildDepends(third_party.compiler_headers)
@BuildDepends(embox.cxx.LibCxx)
module ncnn_conv_smoke {

	source "main.cpp", "fixture.h"

	depends third_party.lib.ncnn.libncnn
	depends third_party.lib.ncnn.ncnn_public_headers
	depends third_party.compiler_headers
	depends embox.cxx.LibCxx
	depends stm32f746_qspi_reader
}

/* Keep BSP/HAL out of the app's BuildDepends closure: app initialization
 * restores those modules' data, including the live SystemCoreClock value. */
@Build(stage=2)
@BuildDepends(platform.stm32.f7.stm32746g_discovery.bsp)
static module stm32f746_qspi_reader {
	source "qspi.c"
	depends platform.stm32.f7.stm32746g_discovery.bsp
}
